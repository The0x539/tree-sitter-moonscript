    },
    "_single_string": {
      "type": "PATTERN",
      "value": "'([^']|\\\\)*'"
    },
    "_double_string": {
      "type": "PATTERN",
      "value": "\"([^\"]|\\\\)*\""
    },
    "_shovel_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\\[\\[.*?\\]\\]"
        },
        {
