    },
    "shebang_path": {
      "type": "PATTERN",
      "value": "[^\\n]*"
    },
    "_space": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 100,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": " "
            },
            {
              "type": "STRING",
              "value": "\t"
            }
          ]
        }
      }
    },
    "comment": {
      "type": "PREC_RIGHT",
      "value": 100,
      "content": {
        "type": "PATTERN",
        "value": "--[^\\n]*"
      }
    },
    "_conclusion": {
      "type": "PATTERN",
      "value": "@@@NO FURTHER(.|\\n)*"
    },
    "_literal": {
